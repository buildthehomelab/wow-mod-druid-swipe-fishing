[worldserver]

########################################
# mod-swipe-fishing
#
# Druids fish in Bear Form. With the Idol of Voracity equipped, a druid in Bear Form faces the
# water and types /roar, and Fishing starts, with no pole. It's normal fishing: bobber, pools,
# skill and loot. Caster form is unchanged: Fishing needs a pole. The idol comes from a druid
# quest in Moonglade.
########################################

#
#    SwipeFishing.Enable
#        Description: Master switch. With 0 the idol does nothing: no fishing in Bear Form.
#        Default:     1
#

SwipeFishing.Enable = 1

#
#    SwipeFishing.StartEmote
#        Description: The text emote that casts Fishing for a druid in Bear Form wearing the idol,
#                     as a TextEmotes.dbc id. 75 is /roar.
#        Default:     75
#

SwipeFishing.StartEmote = 75
