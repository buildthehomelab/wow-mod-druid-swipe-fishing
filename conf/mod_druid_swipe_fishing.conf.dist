[worldserver]

########################################
# mod-druid-swipe-fishing
#
# Druids fish like bears. In Bear Form, standing in water with a salmon relic on, use the relic
# (Salmon Run) and wait.
# When the water splashes, Swipe the fish before it gets away. Catches give the zone's normal fishing loot
# and use the normal fishing skill rules. The relic comes from a druid in Moonglade, and he
# upgrades it at each fishing rank.
########################################

#
#    SwipeFishing.Enable
#        Description: Master switch for the minigame.
#        Default:     1
#

SwipeFishing.Enable = 1

#
#    SwipeFishing.SpellId
#        Description: Salmon Run, the relics' Use effect, which starts (and, used again, stops)
#                     fishing. It must exist on the client (the realm patch built with
#                     client/build_patch.py), in the server's spell_dbc table and on the relics
#                     (the module's SQL). 0 turns it off.
#        Default:     90060
#

SwipeFishing.SpellId = 90060

#
#    SwipeFishing.StartEmote
#        Description: A text emote that also starts fishing, as a TextEmotes.dbc id (75 is
#                     /roar, how fishing started before Salmon Run). 0 for none.
#        Default:     0
#

SwipeFishing.StartEmote = 0

#
#    SwipeFishing.SitWhileWaiting
#        Description: The bear sits down while it waits for a bite. Swiping stands it up.
#        Default:     1
#

SwipeFishing.SitWhileWaiting = 1

#
#    SwipeFishing.BiteDelayMin
#    SwipeFishing.BiteDelayMax
#        Description: How long until a salmon bites (the splash), picked at random between the
#                     two, in milliseconds.
#        Default:     5000, 15000
#

SwipeFishing.BiteDelayMin = 5000
SwipeFishing.BiteDelayMax = 15000

#
#    SwipeFishing.CatchWindow
#        Description: How long after the splash you have to Swipe, in milliseconds.
#        Default:     2000
#

SwipeFishing.CatchWindow = 2000

#
#    SwipeFishing.SpookDelay
#        Description: Extra wait, in milliseconds, after you Swipe too early and scare the fish.
#        Default:     6000
#

SwipeFishing.SpookDelay = 6000

#
#    SwipeFishing.SettleTime
#        Description: For this many milliseconds after a bite ends (caught, slipped away, got away
#                     or spooked), and after a new salmon takes over, a Swipe is ignored instead of
#                     counting as too soon. It stops a second press right after the one that
#                     caught the fish from spooking the next one: Swipe can be free (mod-forever-
#                     druid), and the core queues a press made near the end of the global
#                     cooldown. Never longer than BiteDelayMin.
#        Default:     2000
#

SwipeFishing.SettleTime = 2000

#
#    SwipeFishing.RageOnBite
#        Description: A bear out of combat has no rage, so a bite tops you up to this much rage
#                     (not added on top) so you can Swipe. 0 turns it off.
#        Default:     25
#

SwipeFishing.RageOnBite = 25

#
#    SwipeFishing.MinCatchChance
#        Description: The catch chance follows normal fishing: your fishing skill against the
#                     zone's fishing level, certain at zone level + 95. This is the lowest it can
#                     be, in percent, so a well-timed Swipe isn't wasted too often. Moonglade's
#                     fishing level is 205: a druid with 100 skill would have 11% by the rules.
#                     0 for pure fishing rules.
#        Default:     50
#

SwipeFishing.MinCatchChance = 50

#
#    SwipeFishing.CorpseSeconds
#        Description: How long a caught salmon stays for you to loot, in seconds.
#        Default:     60
#

SwipeFishing.CorpseSeconds = 60

#
#    SwipeFishing.SpotDistance
#        Description: How far in front of you the salmon waits, in yards (2 to 8). If the water
#                     is too shallow there, it tries 1 and 2 yards closer.
#        Default:     4.5
#

SwipeFishing.SpotDistance = 4.5

#
#    SwipeFishing.PoolReach
#        Description: A fishing pool (a school of fish) whose middle is within this many yards of
#                     you when you start fishing is where the salmon waits, instead of the spot in
#                     front of you. A salmon from a pool is a sure catch and gives the pool's
#                     loot, using up one of the pool's catches, as a bobber would. 0 to ignore
#                     pools when choosing the spot (a salmon that happens to be in a pool still
#                     counts). Up to 30.
#        Default:     12
#

SwipeFishing.PoolReach = 12

########################################
# Effects
#
# Existing client sounds and spells for the bite. 0 for none.
########################################

#
#    SwipeFishing.BiteSound
#        Description: Sound played to you when a salmon bites, a SoundEntries.dbc id. 3355 is the
#                     fishing bobber's bite.
#        Default:     3355
#
#    SwipeFishing.SplashSpell
#        Description: Visual-only spell the salmon casts on itself when it bites: the cue to
#                     Swipe. 69665 is a water burst.
#        Default:     69665
#

SwipeFishing.BiteSound = 3355
SwipeFishing.SplashSpell = 69665
